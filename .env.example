# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=IT Ticketing System
APP_DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# CORS (comma-separated origins)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# PostgreSQL
# SQLAlchemy async URL uses postgresql+asyncpg://
# Pool settings are documented in docs/database.md
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://ticketing:ticketing@localhost:5433/ticketing
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# JWT / session
# ACCESS tokens are short-lived. REFRESH tokens are opaque and stored hashed.
# Generate a strong JWT_SECRET before any non-local deployment.
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# MinIO (object storage — used from Milestone 3)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ticketing-attachments
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# Auth rate limiting
# -----------------------------------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Development seed credentials (never use these in production)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=hardik@example.com
SEED_ADMIN_PASSWORD=ChangeMe!Admin123
SEED_ADMIN_RONALD_EMAIL=ronald@example.com
SEED_ADMIN_SANJAY_EMAIL=sanjay@example.com
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=ChangeMe!Employee123

# -----------------------------------------------------------------------------
# Email (leave SMTP_HOST empty to log messages in the API console)
# For Gmail, use an app password and smtp.gmail.com:587
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@localhost
SMTP_FROM_NAME=IT Support
SMTP_USE_TLS=true

# Exact company domains only. Gmail/Yahoo/Outlook are always rejected.
ALLOWED_EMAIL_DOMAINS=company.com,subsidiary.com
EMAIL_CHECK_DELIVERABILITY=true
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# Optional extra bootstrap admin. Demo admins still come from SEED_ADMIN_*.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# Optional extra IT inboxes in addition to Admin-role users.
DEFAULT_IT_NOTIFICATION_EMAILS=

FRONTEND_URL=http://localhost:5173
